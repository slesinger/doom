# Build artifacts. Note that build/doom.prg and build/main.vs are already
# tracked and deliberately stay so: until KickAssembler is available they are
# the only way to run the engine and reproduce the current hang.
build/*.prg
build/*.sym
build/*.vs
build/*.png
build/*.bin
build/*.reu
build/debug.log
# Which REU chunks this host last uploaded, and the token that says whether the
# machine still holds them (tools/u64push.py). Per-machine state, not a build
# artifact -- and stale in a fresh checkout, where it must not be believed.
build/.reu-upload-cache.json

# KickAssembler is not vendored; see IMPLEMENTATION_PLAN.md
tools/kickass/

__pycache__/
*.pyc
src/.source.txt
src/render/.source.txt
src/intro/.source.txt
src/build/
src/intro/build/
build/main.vs
build/intro-audio.asm
